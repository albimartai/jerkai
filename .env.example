# Copy to .env.local and fill in. Never commit .env.local.
# Neon Postgres connection string (dev branch locally; Vercel sets prod/preview per environment).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Shared secret for the Apple Health ingest endpoint (POST /api/ingest/health).
# Sent by Health Auto Export as an `x-api-key` header. Generate: openssl rand -hex 32
HEALTH_EXPORT_SHARED_SECRET=

# Resend API key — sync-failure alerts and Auth.js magic links (same account).
# Auth.js picks this up automatically for the Resend provider (env inference).
AUTH_RESEND_KEY=

# Auth.js session/JWT encryption secret. Generate: openssl rand -base64 32
AUTH_SECRET=

# Comma-separated email addresses allowed to sign in (case-insensitive,
# whitespace-trimmed per entry). Fails closed: unset, empty, or an entry
# list that parses to zero usable addresses denies every sign-in attempt.
ALLOWLISTED_EMAILS=you@example.com

# Canonical app URL — pins production magic-link callbacks to the real domain
# instead of a *.vercel.app deployment URL. See auth.ts.
NEXT_PUBLIC_APP_URL=https://jerkai.app

# Destination for same-day sync-failure alert emails.
SYNC_ALERT_EMAIL_TO=you@example.com

# Whoop Developer Platform OAuth app credentials (developer dashboard). The
# app's registered Redirect URL must be exactly ${NEXT_PUBLIC_APP_URL}/api/whoop/callback.
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=

# Encrypts stored Whoop access/refresh tokens at rest (AES-256-GCM).
# Generate: openssl rand -hex 32
WHOOP_TOKEN_ENCRYPTION_KEY=

# Secures the cron-triggered Whoop sync route (/api/whoop/sync). Vercel sends
# this value as `Authorization: Bearer ...` on every cron invocation.
# Generate: openssl rand -hex 32
CRON_SECRET=

# Email of the user the ingest (/api/ingest/health) and Whoop sync (/api/whoop/sync)
# pipes attribute rows to — both are machine-to-machine, so they resolve this to a
# user_id at request/run time instead of relying on a session. Fails closed: if this
# email resolves to zero or more than one row in `users`, the request/run is rejected
# and no rows are written.
PRIMARY_USER_EMAIL=you@example.com
